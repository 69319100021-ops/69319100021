rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidMonthKey(m) {
      return m is string && m.size() == 7 && m.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.defaultMonthlyBudget is number
        && data.defaultMonthlyBudget >= 0
        && data.defaultMonthlyBudget <= 100000000
        && data.currency == 'THB'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTransaction(data) {
      return data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.type in ['income', 'expense']
        && data.amount is number
        && data.amount > 0
        && data.amount <= 100000000
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.note is string
        && data.note.size() <= 200
        && isValidDate(data.date)
        && isValidMonthKey(data.monthKey)
        && data.date[0:7] == data.monthKey
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMonthlyBudget(data, monthKeyParam) {
      return data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidMonthKey(data.monthKey)
        && data.monthKey == monthKeyParam
        && data.limitAmount is number
        && data.limitAmount >= 0
        && data.limitAmount <= 100000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['uid', 'displayName', 'email', 'defaultMonthlyBudget', 'currency', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'defaultMonthlyBudget', 'currency', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'defaultMonthlyBudget', 'updatedAt']);

      allow delete: if false;

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'type', 'amount', 'category', 'note', 'date', 'monthKey', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'type', 'amount', 'category', 'note', 'date', 'monthKey', 'createdAt', 'updatedAt'])
          && isValidTransaction(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId)
          && isValidTransaction(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['type', 'amount', 'category', 'note', 'date', 'monthKey', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(transactionId)
          && isOwner(userId);
      }

      match /budgets/{monthKey} {
        allow get: if isValidId(userId) && isValidMonthKey(monthKey) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && incoming().keys().hasAll(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly(['userId', 'monthKey', 'limitAmount', 'createdAt', 'updatedAt'])
          && isValidMonthlyBudget(incoming(), monthKey)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerified()
          && isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId)
          && isValidMonthlyBudget(incoming(), monthKey)
          && incoming().userId == existing().userId
          && incoming().monthKey == existing().monthKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['limitAmount', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidMonthKey(monthKey)
          && isOwner(userId);
      }
    }
  }
}
